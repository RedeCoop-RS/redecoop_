APP_NAME="Redecoop"
PORT=3000
TZ=America/Sao_Paulo

# Obrigatório — a API não sobe sem isso
JWT_SECRET=local-dev-secret-change-me
DASHBOARD_URL=http://localhost:5174
WEBSITE_URL=http://localhost:5173

# ── Banco local (MySQL via Docker) ──
DATABASE_TYPE=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=redecoop
DATABASE_PASSWORD=redecoop123
DATABASE_NAME=redecoopapi

# ── Produção (MySQL via túnel SSH) ──
# DATABASE_HOST=localhost
# DATABASE_PORT=3307
# DATABASE_USERNAME=redecoop
# DATABASE_PASSWORD=sua_senha_producao
# DATABASE_NAME=redecoopapi

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@redecooprs.com.br
SMTP_PASS="suasenha"
SMTP_REJECT_UNAUTHORIZED=true
SMTP_FROM="RedeCoop RS <no-reply@redecooprs.com.br>"
CONTACT_INBOX=contato@redecooprs.com.br

# ── Caixa de e-mail do super admin (painel /admin/email) ──
# Distinta do SMTP transacional acima. A senha da caixa NÃO fica aqui:
# o super admin informa no painel e a API grava cifrada (AES-256-GCM).
# Obrigatória para salvar ou ler a senha. Mínimo de 16 caracteres.
MAILBOX_ENCRYPTION_KEY=troque-esta-chave-local
# Intervalo da sincronização automática, em segundos (mínimo 30)
MAILBOX_SYNC_INTERVAL_SECONDS=60
# Mensagens recentes trazidas por pasta a cada sincronização
MAILBOX_SYNC_MESSAGE_LIMIT=200
# Tamanho máximo de cada anexo, em bytes (padrão 15 MB, teto 35 MB)
MAILBOX_MAX_ATTACHMENT_BYTES=15728640
# Pasta dos anexos de rascunho. Fica fora de /storage.
# MAILBOX_UPLOAD_DIR=private-mailbox
# Use false apenas se o provedor usar certificado que o Node rejeita
MAILBOX_TLS_REJECT_UNAUTHORIZED=true
# Multiplica os limites de envio/teste/sincronização por usuário. Deixe 1 em produção.
# MAILBOX_RATE_LIMIT_SCALE=1

# ── Blog do super admin (painel /admin/blog, Ghost Admin API) ──
# A chave também pode ser colada em Blog → Conexão; nesse caso ela é cifrada
# (AES-256-GCM) e a variável pode ficar vazia. Nunca exponha a key no frontend.
# GHOST_ADMIN_URL=https://blog.seudominio.com
# GHOST_ADMIN_API_KEY=idhex:secrethex
# Se vazio, a chave salva no painel usa MAILBOX_ENCRYPTION_KEY.
# GHOST_ENCRYPTION_KEY=troque-esta-chave-local
# GHOST_API_VERSION=v5.0
# GHOST_TIMEOUT_MS=20000

# ── Mapbox (autocomplete de endereços / distância de rotas) ──
# Sem isso, /common/maps/auto-complete falha e as cidades não aparecem no cadastro de viagem
API_MAPS=https://api.mapbox.com
MAPS_TOKEN=pk.seu_token_mapbox_aqui

# ── Sincronização CAF (servidor / VNC) ──
# CAF_PYTHON=/var/www/api-redecoop-source/scripts/caf/.venv/bin/python
# CAF_BROWSER_MODE=vnc
# CAF_DISPLAY=:1
# CAF_VNC_HOST=85.31.231.192
# CAF_VNC_PORT=5901
# VPS_PUBLIC_IP=85.31.231.192


# ── Secrets / deploy local (nunca commitar) ──
docker-compose.yml
.env
.env.*
!**/.env.example
!**/.env.docker.example

# ── Dependências e build ──
**/node_modules/
**/dist/
**/dist-ssr/
**/build/
**/.vite/

# ── API: uploads, logs, CAF ──
api-redecoop/upload/
api-redecoop/logs/
**/coverage/
api-redecoop/scripts/caf/.venv/
api-redecoop/scripts/caf/data/*.json
api-redecoop/scripts/caf/data/*.txt
!api-redecoop/scripts/caf/data/.gitkeep

# ── Logs ──
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / IDE ──
.DS_Store
Thumbs.db
.idea/
**/.vscode/*
!**/.vscode/extensions.json

# ── Temp ──
.temp/
.tmp/
*.local
